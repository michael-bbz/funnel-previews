/* ---- Global reset for this block ---- */
.cs-p4-wrap *,
.cs-p4-wrap *::before,
.cs-p4-wrap *::after { box-sizing: border-box; }
.cs-p4-wrap img,
.cs-p4-wrap video { display: block; max-width: 100%; height: auto; }
/* ============================================================
 SECTION 1 — Finally: A Formula
 ============================================================ */
.cs-finally {
 padding: 38px 20px;
 font-family: Poppins, Arial, sans-serif;
}
.cs-finally__inner {
 max-width: 1100px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
 align-items: center;
 gap: 38px;
}
.cs-finally__title {
 font-size: 30px;
 font-weight: 700;
 color: #17222e;
 line-height: 1.16;
 margin: 0 0 22px;
}
.cs-finally__intro {
 font-size: 18px;
 font-style: italic;
 color: #17222e;
 margin: 0 0 22px;
}
.cs-finally__bullet {
 position: relative;
 padding-left: 34px;
 margin: 0 0 18px;
 font-size: 18px;
 line-height: 1.34;
 color: #17222e;
}
.cs-finally__bullet::before {
 content: "\2713";
 position: absolute;
 left: 0;
 top: 2px;
 width: 23px;
 height: 23px;
 border-radius: 999px;
 background: rgba(23, 34, 63, 1);
 color: #fff;
 display: flex;
 align-items: center;
 justify-content: center;
 font-size: 15px;
 line-height: 1;
 font-weight: 800;
}
.cs-finally__bullet b { font-weight: 800; color: #17222e; }
.cs-finally__result {
 margin: 20px 0 0;
 font-size: 18px;
 line-height: 1.34;
 color: #17222e;
}
.cs-finally__result b { font-weight: 800; }
.cs-finally__media {
 width: 100%;
 border-radius: 16px;
 overflow: hidden;
 line-height: 0;
}
.cs-finally__media video {
 width: 100%;
 height: auto;
 display: block;
}
/* ============================================================
 SECTION 2 — Our Promise
 ============================================================ */
.cs-promise {
 width: 100vw;
 margin-left: calc(50% - 50vw);
 margin-right: calc(50% - 50vw);
 margin-top: 20px;
 padding: 38px max(20px, calc((100vw - 1100px) / 2)) 10px;
 font-family: Poppins, Arial, sans-serif;
 box-sizing: border-box;
}
.cs-promise__shell {
 max-width: 1100px;
 margin: 0 auto;
 display: grid;
 grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
 align-items: center;
 gap: 38px;
 padding: 0 0 12px;
}
.cs-promise__img {
 width: 100%;
 display: block;
}
.cs-promise__content {
 max-width: 640px;
 display: flex;
 flex-direction: column;
 align-items: flex-start;
}
.cs-promise__heading {
 font-size: 30px;
 font-weight: 800;
 color: #17222e;
 line-height: 1.18;
 margin: 0 0 8px;
 text-align: left !important;
}
.cs-promise__rule {
 width: 100%;
 height: 2px;
 background: rgba(23, 34, 46, 0.08);
 margin: 16px 0 22px;
 border: none;
}
.cs-promise__copy {
 font-size: 18px;
 line-height: 1.34;
 color: #17222e;
 margin: 0 0 14px;
}
.cs-promise__badges {
 width: 100%;
 display: grid;
 grid-template-columns: repeat(3, minmax(0, 1fr));
 gap: 2px;
 margin-top: 24px;
}
.cs-promise__badge {
 display: flex;
 flex-direction: column;
 align-items: center;
 text-align: center;
}
.cs-promise__badge-icon {
 width: 160px;
 height: 160px;
 object-fit: contain;
 display: block;
}
.cs-promise__badge-label {
 font-size: 14px;
 font-weight: 700;
 color: #17222e;
 line-height: 1.2;
 transform: translateY(-8px);
}
/* ============================================================
 SECTION 3 — What to Expect (Step 3 Clean)
 ============================================================ */
.cs-step3 {
 width: 100vw;
 margin-left: calc(50% - 50vw);
 margin-right: calc(50% - 50vw);
 margin-top: 20px;
 background: rgba(250, 244, 238, 1);
 padding: 38px max(20px, calc((100vw - 1100px) / 2));
 box-sizing: border-box;
 font-family: Poppins, Arial, sans-serif;
}
.cs-step3__inner {
 max-width: 1100px;
 margin: 0 auto;
 display: flex;
 flex-direction: column;
 gap: 28px;
}
.cs-step3__top {
 display: grid;
 grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
 align-items: center;
 gap: 38px;
}
.cs-step3__copy { width: 100%; }
.cs-step3__copy--mobile { display: none; }
.cs-step3__title {
 font-size: 30px;
 font-weight: 700;
 color: #303030;
 line-height: 1.16;
 margin: 0 0 18px;
}
.cs-step3__intro {
 font-size: 18px;
 font-style: italic;
 color: #17222e;
 line-height: 1.34;
 margin: 0 0 18px;
}
/* ---- Scrollable rail (desktop) ---- */
.cs-step3__slider { width: 100%; margin: 0 0 20px; }
.cs-step3__rail {
 display: flex;
 gap: 12px;
 overflow-x: auto;
 overflow-y: hidden;
 scrollbar-width: thin;
 scrollbar-color: rgba(23, 34, 63, 1) rgba(23, 34, 63, 0.14);
 cursor: grab;
 user-select: none;
 flex-wrap: nowrap;
 padding: 4px 0 12px;
}
.cs-step3__rail::-webkit-scrollbar { display: block; height: 12px; }
.cs-step3__rail::-webkit-scrollbar-track {
 background: rgba(23, 34, 63, 0.14);
 border-radius: 999px;
}
.cs-step3__rail::-webkit-scrollbar-thumb {
 background: rgba(23, 34, 63, 1);
 border-radius: 999px;
}
.cs-step3__item {
 position: relative;
 flex: 0 0 47%;
 min-width: 0;
 display: flex;
 flex-direction: column;
 padding-top: 10px;
}
.cs-step3__item-head {
 position: absolute;
 top: -4px;
 right: 12px;
 z-index: 2;
}
.cs-step3__card-week {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 8px;
 min-width: 86px;
 border-radius: 8px;
 background: rgba(23, 34, 63, 1);
 color: #fff;
 font-size: 12px;
 font-weight: 700;
 white-space: nowrap;
 padding: 5px 14px 6px;
}
.cs-step3__week-icon {
 width: 22px;
 height: 22px;
 object-fit: contain;
 display: block;
 flex: 0 0 auto;
}
.cs-step3__card {
 width: 100%;
 flex: 1 1 auto;
 min-height: 186px;
 background: #fff;
 border: 1px solid rgba(23, 34, 46, 0.12);
 border-radius: 14px;
 box-shadow: 0 8px 18px rgba(23, 34, 46, 0.06);
 overflow: hidden;
 padding: 20px 20px 18px;
}
.cs-step3__card-title {
 font-size: 20px;
 font-weight: 700;
 color: #17222e;
 line-height: 1.18;
 margin: 0 0 12px;
 min-height: 46px;
}
.cs-step3__card-copy {
 font-size: 15px;
 font-weight: 400;
 color: #17222e;
 line-height: 1.42;
 margin: 0;
 min-height: 104px;
}
/* ---- Disclaimer ---- */
.cs-step3__disclaimer {
 font-size: 13px;
 color: rgba(23, 34, 46, 0.72);
 line-height: 1.5;
 margin: 0;
}
/* ---- Right media ---- */
.cs-step3__media { width: 100%; }
.cs-step3__media-frame {
 width: 100%;
 aspect-ratio: 1 / 1;
 overflow: hidden;
 border-radius: 16px;
}
.cs-step3__media-frame img {
 width: 100%;
 height: 100%;
 object-fit: cover;
 display: block;
}
/* ---- Mobile timeline ---- */
.cs-step3__timeline-mobile { display: none; }
/* ============================================================
 RESPONSIVE — mobile ≤ 768px
 ============================================================ */
@media (max-width: 768px) {
 /* Section 1 */
 .cs-finally { padding: 24px 20px; }
 .cs-finally__inner {
 display: flex;
 flex-direction: column;
 gap: 0;
 }
 /* On mobile: header (title+intro) first, then media, then body (bullets+result) */
 .cs-finally__copy { display: contents; }
 .cs-finally__header { order: 1; margin-bottom: 14px; }
 .cs-finally__media { order: 2; margin: 0 0 14px; border-radius: 12px; }
 .cs-finally__body { order: 3; }
 .cs-finally__title { font-size: 24px; margin: 0 0 10px; }
 .cs-finally__intro { font-size: 16px; margin: 0; }
 .cs-finally__bullet { font-size: 16px; line-height: 1.3; margin: 0 0 14px; }
 .cs-finally__result { font-size: 16px; line-height: 1.3; margin: 12px 0 0; }
 /* Section 2 */
 .cs-promise {
 width: 100%;
 margin-left: 0;
 margin-right: 0;
 padding: 0 24px;
 margin-top: 18px;
 }
 .cs-promise__shell {
 display: flex;
 flex-direction: column;
 gap: 0;
 max-width: 648px;
 margin: 0;
 padding: 0;
 }
 .cs-promise__media { order: 3; margin: 0 0 8px; }
 .cs-promise__content { order: 1; display: contents; max-width: 100%; }
 .cs-promise__heading { order: 1; font-size: 24px; margin: 0 0 8px; text-align: left !important; width: 100% !important; }
 .cs-promise__rule { display: none; }
 .cs-promise__copy-wrap { order: 2; margin: 0 0 8px; }
 .cs-promise__copy { font-size: 16px; line-height: 1.3; }
 .cs-promise__badges {
 order: 4;
 gap: 6px;
 margin-top: 0;
 padding: 0 0 16px;
 }
 .cs-promise__badge-icon { width: 114px; height: 114px; }
 .cs-promise__badge-label { font-size: 12px; transform: translateY(-6px); }
 /* Section 3 */
 .cs-step3 {
 width: 100vw;
 margin-left: calc(50% - 50vw);
 margin-right: calc(50% - 50vw);
 margin-top: 0;
 padding: 24px 0 26px;
 }
 .cs-step3__inner {
 width: calc(100% - 48px);
 max-width: 648px;
 margin-left: auto;
 margin-right: auto;
 display: flex;
 flex-direction: column;
 gap: 0;
 }
 .cs-step3__top { display: contents; }
 .cs-step3__copy { display: contents; }
 .cs-step3__copy--mobile { display: contents; }
 .cs-step3__title { order: 1; font-size: 25px; margin: 0 0 10px; }
 .cs-step3__intro { order: 2; font-size: 16px; line-height: 1.3; margin: 0 0 14px; }
 .cs-step3__slider { display: none; }
 .cs-step3__disclaimer--desktop { display: none; }
 .cs-step3__media { order: 3; display: block; margin: 0 0 14px; }
 .cs-step3__media-frame { border-radius: 12px; }
 /* Mobile timeline */
 .cs-step3__timeline-mobile {
 display: block;
 order: 4;
 position: relative;
 padding-left: 28px;
 margin: 2px 0 0;
 }
 .cs-step3__timeline-mobile::before {
 content: "";
 position: absolute;
 left: 7px;
 top: 20px;
 bottom: 20px;
 width: 2px;
 background: rgba(23, 34, 63, 0.22);
 }
 .cs-step3__timeline-item { position: relative; margin: 0 0 18px; }
 .cs-step3__timeline-dot {
 position: absolute;
 left: -28px;
 top: 24px;
 width: 14px;
 height: 14px;
 border-radius: 999px;
 background: rgba(23, 34, 63, 1);
 box-shadow: 0 0 0 4px rgba(23, 34, 63, 0.14);
 }
 .cs-step3__timeline-card {
 position: relative;
 background: #fff;
 border: 1px solid rgba(23, 34, 46, 0.12);
 border-radius: 14px;
 box-shadow: 0 8px 18px rgba(23, 34, 46, 0.06);
 padding: 18px 18px 16px;
 }
 .cs-step3__timeline-week {

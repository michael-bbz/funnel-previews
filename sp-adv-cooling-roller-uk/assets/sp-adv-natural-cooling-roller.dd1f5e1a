<script>
(function() {
 var duration = 45 * 60;
 var startedAt = Date.now();
 function pad(n) { return String(n).padStart(2, '0'); }
 function render() {
 var elapsed = Math.floor((Date.now() - startedAt) / 1000);
 var remaining = Math.max(duration - elapsed, 0);
 var label = remaining === 0 ? 'EXPIRED' : pad(Math.floor(remaining / 60)) + ':' + pad(remaining % 60);
 var el = document.getElementById('cs-cta-countdown');
 if (el) el.textContent = label;
 }
 render();
 setInterval(render, 1000);
})();
(function() {
 document.querySelectorAll('a[href="#nv-best-offer"]').forEach(function(link) {
 link.addEventListener('click', function(e) {
 var isMobile = window.innerWidth < 768;
 var target = isMobile
 ? (document.querySelector('kaching-bundles-block') ||
 document.getElementById('nv-best-offer'))
 : document.getElementById('nv-best-offer');
 if (target) {
 e.preventDefault();
 var hdr = document.querySelector('.cs-sticky-header');
 var offset = hdr ? hdr.offsetHeight : 0;
 var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
 window.scrollTo({ top: top, behavior: 'smooth' });
 }
 });
 });
})();
</script>

 border-radius: 18px;
 object-fit: cover;
}
/* ── TABLET (769–1100px) ── */
@media (min-width: 769px) and (max-width: 1100px) {
 .cs-dr-headline { font-size: 26px; }
 .cs-dr-emphasis { font-size: 26px; }
}
/* ── MOBILE (≤768px) ── */

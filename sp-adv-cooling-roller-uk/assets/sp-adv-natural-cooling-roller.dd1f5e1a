<script>
/* ============================================================
 FAQ Accordion
 ============================================================ */
(function() {
 var faqData = [
 ["How soon will I see results?",
 "You feel it on the first roll — a cool wave as it sinks in. That early softness is real, but it's mostly hydration. The firmer look takes longer: 8 to 12 weeks, as the Centella works. With consistent use, most women notice by week 3 or 4."],
 ["Where on my body can I use it?",
 "This is a clinical-strength formula made for the body — your arms, legs, thighs, knees, and the backs of your hands. That's exactly where crepey, papery skin shows, and where it works best. It's made for body skin, so don't use it on your face or neck."],
 ["How is this different from the creams and collagen I've already tried?",
 "Creams just sit on top — they can't get past your skin's barrier. Our roller is built different: menthol, a penetration enhancer, and deep massage work together to drive the botanicals underneath. It's one of the most effective ways a topical can actually work."],
 ["The cooling feeling – is that normal?",
 "Yes — that's the point. The cool wave is the menthol opening tiny channels so the botanicals get underneath. It's a gentle cool, not a burn — we keep the menthol low on purpose."],
 ["Is it safe, and who should not use it?",
 "It's formulated gentle, with the menthol dosed low — but always patch-test first. Don't use it if you're pregnant, breastfeeding, or have broken skin. On blood thinners, diabetes, or blood-pressure meds? Check with your doctor first. Keep it away from your eyes."],
 ["How do I use it, and will it feel greasy?",
 "Once a day, roll it over clean, dry skin — one pass, about 30 seconds. No rubbing in, easy even on stiff hands. It dries fast: no grease, no strong menthol smell, no marks on clothes or sheets. One roller lasts weeks."],
 ["Can I buy this on Amazon or in stores?",
 "No — only here, on our official site. That's the only way to get the real, full-strength formula, fresh and sealed, with your 90-day guarantee. The Amazon look-alikes aren't ours."],
 ["How long does shipping take?",
 "It ships free within 24 hours, and you'll get a tracking link by email right away. Most orders arrive in about 5–7 business days."],
 ["What if it doesn't work for me?",
 "Then you don't pay. You get a full 90 days to try it — that's how long the real change takes. Don't love what you see? Tell us, and we'll refund every penny. No questions."]
 ];
 var chevronSvg = '<svg class="cs-faq__chevron" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 25" fill="none" aria-hidden="true"><path d="M12.0021 8.58771C11.8705 8.58694 11.7401 8.61217 11.6182 8.66193C11.4964 8.7117 11.3856 8.78502 11.2921 8.87771L5.29214 14.8777C5.10383 15.066 4.99805 15.3214 4.99805 15.5877C4.99805 15.854 5.10383 16.1094 5.29214 16.2977C5.48044 16.486 5.73584 16.5918 6.00214 16.5918C6.26844 16.5918 6.52383 16.486 6.71214 16.2977L12.0021 10.9977L17.2921 16.2877C17.4834 16.4515 17.7295 16.5371 17.9812 16.5274C18.2329 16.5177 18.4716 16.4134 18.6497 16.2353C18.8278 16.0572 18.9321 15.8184 18.9418 15.5668C18.9516 15.3151 18.866 15.069 18.7021 14.8777L12.7021 8.87771C12.5159 8.69296 12.2645 8.58881 12.0021 8.58771Z" fill="#404040"/></svg>';
 var list = document.getElementById('cs-faq-list');
 if (!list) return;
 var html = '';
 for (var i = 0; i < faqData.length; i++) {
 html += '<div class="cs-faq__item">' +
 '<div class="cs-faq__item-inner">' +
 '<div class="cs-faq__question-row">' +
 '<h3 class="cs-faq__question">' + faqData[i][0] + '</h3>' +
 '<div>' + chevronSvg + '</div>' +
 '</div>' +
 '<div class="cs-faq__answer"><span class="cs-faq__answer-text">' + faqData[i][1] + '</span></div>' +
 '</div>' +
 '</div>';
 }
 list.innerHTML = html;
 list.addEventListener('click', function(e) {
 var item = e.target.closest('.cs-faq__item');
 if (!item) return;
 var answer = item.querySelector('.cs-faq__answer');
 var chevron = item.querySelector('.cs-faq__chevron');
 var isOpen = answer.style.maxHeight && answer.style.maxHeight !== '0px';
 // Close all
 list.querySelectorAll('.cs-faq__answer').forEach(function(a) { a.style.maxHeight = '0px'; a.style.paddingTop = '0px'; });
 list.querySelectorAll('.cs-faq__chevron').forEach(function(c) { c.classList.remove('cs-faq__chevron--open'); });
 // Toggle clicked
 if (!isOpen) {
 answer.style.maxHeight = answer.scrollHeight + 48 + 'px';
 answer.style.paddingTop = '12px';
 chevron.classList.add('cs-faq__chevron--open');
 }
 });
})();
/* ============================================================
 Countdown Timer (shared across CTA sections)
 ============================================================ */
(function() {
 var duration = 45 * 60;
 var startedAt = Date.now();
 function pad(n) { return String(n).padStart(2, '0'); }
 function render() {
 var elapsed = Math.floor((Date.now() - startedAt) / 1000);
 var remaining = Math.max(duration - elapsed, 0);
 var label = remaining === 0 ? 'EXPIRED' : pad(Math.floor(remaining / 60)) + ':' + pad(remaining % 60);
 var el = document.getElementById('cs-offer-countdown');
 if (el) el.textContent = label;
 }
 render();
 setInterval(render, 1000);
})();
(function() {
 document.querySelectorAll('a[href="#nv-best-offer"]').forEach(function(link) {
 link.addEventListener('click', function(e) {
 var isMobile = window.innerWidth < 768;
 var target = isMobile
 ? (document.querySelector('kaching-bundles-block') ||
 document.getElementById('nv-best-offer'))
 : document.getElementById('nv-best-offer');
 if (target) {
 e.preventDefault();
 var hdr = document.querySelector('.cs-sticky-header');
 var offset = hdr ? hdr.offsetHeight : 0;
 var top = target.getBoundingClientRect().top + window.pageYOffset - offset;
 window.scrollTo({ top: top, behavior: 'smooth' });
 }
 });
 });
})();
</script>
<style> /* =============================== PRODUCT + BLOG CONTENT LINKS =============================== */.product__description a,.product__description a:link,.product__description a:visited,.article-template__content a,.article-template__content a:link,.article-template__content a:visited {color: #052f54 !important;}  /* Hover / active states */.product__description a:hover,.article-template__content a:hover {color: #052f54 !important; text-decoration: underline;}  /* Remove focus outline on mouse click */.product__description a:focus:not(:focus-visible),.article-template__content a:focus:not(:focus-visible) {outline: none !important; box-shadow: none !important;}  /* Keyboard focus only (accessibility-safe) */.product__description a:focus-visible,.article-template__content a:focus-visible {outline: 2px solid #052f54; outline-offset: 2px;}  /* =============================== STOP OUTLINE/BOX ON MOUSE CLICK Keep focus ring for keyboard only =============================== */ /* Remove any theme focus styles on normal focus (mouse click) */a:focus {outline: none !important; box-shadow: none !important;}  /* Bring back focus ring ONLY for keyboard navigation */a:focus-visible {outline: 2px solid currentColor !important; outline-offset: 2px !important; box-shadow: none !important;}  /* Make your scoped areas use the exact color you want */.product__description a:focus-visible,.article-template__content a:focus-visible {outline-color: #052f54 !important;}  /* Footer focus ring stays white */footer a:focus-visible {outline-color: #f8f8fa !important;} </style>

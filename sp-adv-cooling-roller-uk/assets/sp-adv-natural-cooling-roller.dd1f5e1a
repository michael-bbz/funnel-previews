 overflow: hidden;
 line-height: 0;
 margin: 0 !important;
 padding: 0 !important;
}
.cs-dr-collagen-img {
 width: 100%;
 height: auto;
 display: block;
 border-radius: 18px;
}
/* gap between image and text copy */
.cs-dr-collagen-copy {
 max-width: none;
 margin-top: 24px !important;
}
/* Added bands */
.cs-dr-added-band {

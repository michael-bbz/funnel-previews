<script>
/* Mobile comparison slider */
(function() {
 var track = document.getElementById('cs-ms-track');
 var prevBtn = document.getElementById('cs-ms-prev');
 var nextBtn = document.getElementById('cs-ms-next');
 var pip = document.getElementById('cs-ms-pip');
 if (!track || !prevBtn || !nextBtn) return;
 var total = 4;
 var current = 0;
 function update() {
 track.style.transform = 'translateX(-' + (current * 25) + '%)';
 if (pip) pip.style.left = (current * 25) + '%';
 prevBtn.disabled = current === 0;
 nextBtn.disabled = current === total - 1;
 }
 prevBtn.addEventListener('click', function() { if (current > 0) { current--; update(); } });
 nextBtn.addEventListener('click', function() { if (current < total - 1) { current++; update(); } });
 update();
})();
</script>
<style> /* =============================== PRODUCT + BLOG CONTENT LINKS =============================== */.product__description a,.product__description a:link,.product__description a:visited,.article-template__content a,.article-template__content a:link,.article-template__content a:visited {color: #052f54 !important;}  /* Hover / active states */.product__description a:hover,.article-template__content a:hover {color: #052f54 !important; text-decoration: underline;}  /* Remove focus outline on mouse click */.product__description a:focus:not(:focus-visible),.article-template__content a:focus:not(:focus-visible) {outline: none !important; box-shadow: none !important;}  /* Keyboard focus only (accessibility-safe) */.product__description a:focus-visible,.article-template__content a:focus-visible {outline: 2px solid #052f54; outline-offset: 2px;}  /* =============================== STOP OUTLINE/BOX ON MOUSE CLICK Keep focus ring for keyboard only =============================== */ /* Remove any theme focus styles on normal focus (mouse click) */a:focus {outline: none !important; box-shadow: none !important;}  /* Bring back focus ring ONLY for keyboard navigation */a:focus-visible {outline: 2px solid currentColor !important; outline-offset: 2px !important; box-shadow: none !important;}  /* Make your scoped areas use the exact color you want */.product__description a:focus-visible,.article-template__content a:focus-visible {outline-color: #052f54 !important;}  /* Footer focus ring stays white */footer a:focus-visible {outline-color: #f8f8fa !important;} </style>

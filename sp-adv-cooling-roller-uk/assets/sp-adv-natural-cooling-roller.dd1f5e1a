lass="ecom-product-single__add-to-cart-buttons-wrapper"><button type="submit" class="ecom-product-single__add-to-cart--submit ecom-flex" data-text-add-cart="Add to Cart" data-text-pre-order="Pre Order" data-text-unavailable="Unavailable" data-text-outstock="Out stock" data-text-added-cart="Added to bag" data-message-added-cart="Added to cart" data-href="#" data-target="" data-action="checkout" data-variant-id="55643429962020" name="add"><span class="ecom-add-to-cart-text">Add to Cart</span><span class="ecom__element--button-icon"></span></button></div></div></div></div></div></div> <div class="ecom-block ecom-core core__block elmspace ecom-dxkjm0rfokc"><div data-v-6a92e952="" class="ecom__element ecom-element element__code exporting" section_id="ecom-23m5pcnifhs" deep="2"><html><head><style>
 @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');
 /* ---- font only: match Nattovia's widget font (system stack).
 All other Kaching design (offers, colors, badges) stays as set in the app ---- */
 .kaching-bundles__block,
 .kaching-bundles__block * {
 font-family: "system_ui", -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', 'Noto Sans', Arial, sans-serif !important;
 }
 /* tighten the gap between the product title and the Kaching widget */
 div.ecom-block.ecom-core.ecom-3jawtshif8l.ec-button-action { margin-top: 0 !important; }
 .kaching-bundles__block { margin-top: 8px !important; }
 /* hide the visible Subscribe & Save checkbox row (stays checked underneath) */
 .kaching-bundles__subscriptions--checkbox { display: none !important; }
 /* ---- perks + buy-once link ---- */
 #nv-sub-perks { margin-top: 12px; padding: 0; list-style: none; }
 #nv-sub-perks li { display: flex; align-items: center; gap: 8px; font-size: 13px; color: #333; margin-bottom: 6px; font-family: 'Plus Jakarta Sans', sans-serif; }
 #nv-sub-perks li::before { content: '\2713'; color: #3a6051; font-weight: bold; font-size: 14px; }
 #nv-buy-once-link { display: block; text-align: center; margin-top: 12px; color: #000; font-size: 13px; text-decoration: none; letter-spacing: 0.5px; cursor: pointer; font-family: 'Plus Jakarta Sans', sans-serif; }
 #nv-buy-once-link:hover { color: #111; text-decoration: underline; }
 /* ---- payment icons ---- */
 .nv-pw *, .nv-pw *::before, .nv-pw *::after { box-sizing: border-box; margin: 0; padding: 0; }
 .nv-pw { font-family: 'Plus Jakarta Sans', sans-serif; color: #2b2b2b; }
 .nv-pw .pay-icons {
 display: flex;
 align-items: center;
 flex-wrap: wrap;
 justify-content: center;
 gap: 6px;
 padding: 10px 0;
 margin-top: -12px;
 margin-bottom: -8px;
 }
 .nv-pw .pay-icon { height: 30px; width: auto; border-radius: 3px; display: block; }
 .nv-pw .pay-icon--apple { border: 1px solid #e0e0e0; border-radius: 4px; }
 @media (max-width: 766px) {
 .nv-pw .pay-icons { margin-bottom: -5px; }
 .nv-pw .pay-icon { height: 24px; }
 }
</style>
</head><body><div class="nv-pw">
<div class="pay-icons">

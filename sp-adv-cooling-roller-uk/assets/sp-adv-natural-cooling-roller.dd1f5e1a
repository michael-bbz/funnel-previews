      <style id="kaching-bundles-custom-css">
        .kaching-bundles [data-deal-block-id="5d36b0db-bdf9-43a1-b001-5b5660e83455"] {
  .kaching-bundles__bar-price {
    font-size: 20px;
  }

  .kaching-bundles__bar-full-price,
  .kaching-bundles__bar-unit-price {
    font-size: 18px;
  }

  .kaching-bundles__bar-price::before {
    content: "Total: ";
  }
}


.kaching-bundles__subscriptions__card.kaching-bundles__bar-container {
  background: transparent;
  border: none !important;

}

.kaching-bundles__bar-main {
  min-height: 35px !important;
}

.kaching-bundles__subscriptions__checkbox {

  color: white !important;

  background: #509C33 !important;

  border: 1px solid #509C33 !important;

}

.kaching-bundles__subscriptions__checkbox:not(:has(svg)) {
  border: 1px solid #509C33 !important;
  background: transparent !important;
}

.appstle_sub_widget.WIDGET_TYPE_7 {
  display: none !important;
}

@media (max-width: 768px) {
  .kaching-bundles .kaching-bundles__bars--horizontal.kaching-bundles__bars {
    flex-direction: column !important;
  }
}

[data-deal-block-id="5d36b0db-bdf9-43a1-b001-5b5660e83455"] .kaching-bundles__bar-image {
  height: 250px !important;
  width: 250px !important;
}

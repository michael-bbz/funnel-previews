 <button class="cs-cond-arrow cs-cond-next" id="cs-cond-next" aria-label="Next" style="opacity: 1; pointer-events: auto;">›</button>
 </div>
 
 <div class="cs-cond-dots" id="cs-cond-dots"><button class="cs-cond-dot active" aria-label="Go to slide 1"></button><button class="cs-cond-dot" aria-label="Go to slide 2"></button><button class="cs-cond-dot" aria-label="Go to slide 3"></button><button class="cs-cond-dot" aria-label="Go to slide 4"></button><button class="cs-cond-dot" aria-label="Go to slide 5"></button></div>
</div>
<script>
(function() {
 var track = document.getElementById('cs-cond-track');
 var cards = track.querySelectorAll('.cs-cond-card');
 var prevBtn = document.getElementById('cs-cond-prev');
 var nextBtn = document.getElementById('cs-cond-next');
 var dotsWrap = document.getElementById('cs-cond-dots');
 var current = 0;
 function getVisible() {
 return window.innerWidth <= 768 ? 1 : 3;
 }
 function getMax() {
 return Math.max(0, cards.length - getVisible());
 }
 function update() {
 var cardWidth = cards[0].offsetWidth + 14; // width + 7px margin each side
 track.style.transform = 'translateX(-' + (current * cardWidth) + 'px)';
 var dots = dotsWrap.querySelectorAll('.cs-cond-dot');
 for (var d = 0; d < dots.length; d++) {
 dots[d].className = d === current ? 'cs-cond-dot active' : 'cs-cond-dot';
 }
 prevBtn.style.opacity = current === 0 ? '0.3' : '1';
 prevBtn.style.pointerEvents = current === 0 ? 'none' : 'auto';
 nextBtn.style.opacity = current >= getMax() ? '0.3' : '1';
 nextBtn.style.pointerEvents = current >= getMax() ? 'none' : 'auto';
 }
 function buildDots() {
 dotsWrap.innerHTML = '';
 var max = getMax();
 for (var i = 0; i <= max; i++) {
 (function(idx) {
 var dot = document.createElement('button');
 dot.className = idx === current ? 'cs-cond-dot active' : 'cs-cond-dot';
 dot.setAttribute('aria-label', 'Go to slide ' + (idx + 1));
 dot.addEventListener('click', function() {
 current = idx;
 update();
 });
 dotsWrap.appendChild(dot);
 })(i);
 }
 }
 prevBtn.addEventListener('click', function() {
 if (current > 0) { current--; update(); }
 });
 nextBtn.addEventListener('click', function() {
 if (current < getMax()) { current++; update(); }
 });
 // Touch / swipe
 var touchX = 0;
 track.addEventListener('touchstart', function(e) {
 touchX = e.touches[0].clientX;
 }, { passive: true });
 track.addEventListener('touchend', function(e) {
 var diff = touchX - e.changedTouches[0].clientX;
 if (Math.abs(diff) > 40) {
 if (diff > 0 && current < getMax()) { current++; update(); }
 if (diff < 0 && current > 0) { current--; update(); }
 }
 });
 // Resize
 window.addEventListener('resize', function() {
 if (current > getMax()) current = getMax();
 buildDots();
 update();
 });
 buildDots();
 update();
})();
</script>

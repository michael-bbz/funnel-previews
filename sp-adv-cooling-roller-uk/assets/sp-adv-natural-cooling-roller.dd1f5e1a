/* ── RESET ── */
.cs-wrap *, .cs-wrap *::before, .cs-wrap *::after { box-sizing: border-box; }
.cs-wrap img, .cs-wrap video { display: block; max-width: 100%; height: auto; }
.cs-wrap a { text-decoration: none; }
.cs-wrap p { margin: 0; }
/* ── BANNER ── */
.cs-banner { line-height: 0; margin: 0; padding: 0; }
.cs-banner a { display: block; }
.cs-banner-desktop { display: block !important; width: 100%; cursor: pointer; }
.cs-banner-mobile { display: none !important; width: 100%; cursor: pointer; }
@media (max-width: 768px) {
 .cs-banner-desktop { display: none !important; }
 .cs-banner-mobile { display: block !important; }
}
/* ── STICKY HEADER ── */
.cs-sticky-header {
 position: relative;
 width: 100%;
 background-color: rgba(252, 246, 238, 1);
 box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}
/* Self-contained resets so header looks identical inside .cs-wrap or in body */
.cs-sticky-header,
.cs-sticky-header *,
.cs-sticky-header *::before,
.cs-sticky-header *::after { box-sizing: border-box; margin: 0 !important; }
.cs-sticky-header img { display: block; max-width: 100%; height: auto; }
.cs-sticky-header a { text-decoration: none; }
.cs-sticky-header.cs-hdr-fixed {
 position: fixed !important;
 top: 0 !important;
 left: 0 !important;
 right: 0 !important;
 width: 100% !important;
 z-index: 99999 !important;
}
.cs-sticky-inner {
 max-width: 1200px;
 display: flex;
 flex-direction: row;
 justify-content: space-between;
 align-items: center;
 margin: 0 auto !important;
 padding: 10px 24px;
}
.cs-hdr-logo { height: 33px; width: 154px; object-fit: contain; }
.cs-hdr-cta,
.cs-hdr-cta:link,
.cs-hdr-cta:visited {
 color: #fff !important;
 text-decoration: none !important;
 display: inline-flex !important;
 align-items: center !important;
 font-family: Poppins, sans-serif;
 font-size: 13px;
 font-weight: 700;
 border-radius: 60px;
 line-height: 1 !important;
 background-color: rgba(5, 47, 85, 1);
 height: 40px !important;
 box-shadow: rgba(155,155,155,1) 5px 5px 5px 0px;
 white-space: nowrap;
 transition: background-color 0.2s ease;
 padding: 0 18px !important;
 cursor: pointer;
}
.cs-hdr-cta:hover { background-color: rgba(10, 60, 105, 1); color: #fff !important; text-decoration: none !important; }
.cs-hdr-cta:active { text-decoration: underline !important; }
@media (max-width: 480px) {
 .cs-sticky-inner { padding: 10px 16px; }
 .cs-hdr-logo { height: 28px; width: 130px; }
 .cs-hdr-cta { font-size: 12px; padding: 8px 14px; }
}
/* ── DR INTRO SECTION ── */
.cs-dr-intro {
 background: #fff;
 font-family: Poppins, sans-serif;
 color: rgba(5,5,5,1);
 border-bottom: 1px solid rgba(236,230,223,1);
 padding: 40px 20px 48px;
 overflow-x: hidden;
}
.cs-dr-wrap {
 width: 100%;
 max-width: 1100px;
 margin: 0 auto;
}
/* Headline */
.cs-dr-headline {
 max-width: 820px;
 color: rgba(23,34,46,1);
 font-family: Poppins, sans-serif;
 font-size: 30px;
 line-height: 1.18;
 font-weight: 800;
 letter-spacing: 0;
 text-align: center;
 margin: 0 auto 24px;
}
/* Proof row (image + support text) */
.cs-dr-proof-row {
 display: block;
 width: 100%;
 max-width: 820px;
 background: #fff;
 border: 2px solid #fff;
 border-radius: 28px;
 overflow: hidden;
 box-shadow: 0 14px 24px rgba(6,24,43,0.14);
 margin: 0 auto 36px;
}
.cs-dr-proof-img {
 display: block;
 width: 100%;
 height: auto;
 aspect-ratio: 3 / 2;
 object-fit: cover;
 border-radius: 22px 22px 0 0;
}
.cs-dr-support {
 background: rgba(250,244,238,1);
 color: rgba(47,52,56,1);
 font-size: 18px;
 line-height: 1.42;
 font-weight: 500;
 text-align: center;
 margin: 0;
 padding: 17px 42px 19px;
}
/* Body copy */
.cs-dr-body { max-width: 1100px; margin: 0 auto; }
.cs-dr-intro-copy { max-width: 760px; margin: 0 auto 36px; }
.cs-dr-copy p {
 color: rgba(47,52,56,1);
 font-size: 18px;
 line-height: 1.45;
 font-weight: 500;
 margin: 0 0 18px !important;
 padding: 0 !important;
}
.cs-dr-copy p:last-child { margin-bottom: 0 !important; }
.cs-dr-strong { font-weight: 800 !important; }
/* Section headings (emphasis) */
.cs-dr-emphasis {
 color: rgba(23,34,46,1);
 font-family: Poppins, sans-serif;
 font-size: 30px;
 line-height: 1.18;
 font-weight: 800;

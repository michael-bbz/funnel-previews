</div>
<script>
(function () {
 var selectedBarIndex = 1; /* default-selected bar (0-based): middle bar */
 var productVariants = {};
 var perksConfig = {
 0: ['Delivered every month', 'Skip, Pause, or Cancel Anytime'],
 1: ['Delivered every month', 'Skip, Pause, or Cancel Anytime'],
 2: ['Delivered every 2 months', 'Skip, Pause, or Cancel Anytime']
 };
 function formatPrice(cents) {
 var cur = (window.Shopify && Shopify.currency && Shopify.currency.active) || 'GBP';
 var symbol = ({ GBP: '\u00a3', USD: '$', PHP: '\u20b1' })[cur] || '\u00a3';
 return symbol + (cents / 100).toFixed(2);
 }
 function getKachingData() {
 var block = document.querySelector('kaching-bundles-block');
 if (!block) return null;
 try { return JSON.parse(block.getAttribute('deal-block')); } catch (e) { return null; }
 }
 function getOneTimePriceForBar(barIndex) {
 var data = getKachingData();
 if (!data || !data.dealBars || !data.defaultVariantsV2) return null;
 var bar = data.dealBars[barIndex];
 if (!bar) return null;
 var mapping = null;
 for (var i = 0; i < data.defaultVariantsV2.length; i++) {
 if (data.defaultVariantsV2[i].dealBarId === bar.id) { mapping = data.defaultVariantsV2[i]; break; }
 }
 if (!mapping || !mapping.variantGIDs || !mapping.variantGIDs[0]) return null;
 var price = productVariants[mapping.variantGIDs[0]] || null;
 if (price == null) return null;
 /* if every bar maps to the same variant, the deal is quantity-based:
 one-time price = unit price x bar quantity */
 var allSame = data.defaultVariantsV2.every(function (m) {
 return m.variantGIDs && m.variantGIDs[0] === mapping.variantGIDs[0];
 });
 if (allSame && bar.quantity > 1) price = price * bar.quantity;
 return price;
 }
 function fetchProductVariants() {
 var pathParts = window.location.pathname.split('/');
 var productIdx = pathParts.indexOf('products');
 var handle = productIdx !== -1 ? pathParts[productIdx + 1].split('?')[0] : null;
 if (!handle) return;
 fetch('/products/' + handle + '.js')
 .then(function (r) { return r.json(); })
 .then(function (product) {
 product.variants.forEach(function (v) { productVariants[v.id] = v.price; });
 updateLinkText();
 });
 }
 function updateLinkText() {
 var link = document.getElementById('nv-buy-once-link');
 if (!link) return;
 var price = getOneTimePriceForBar(selectedBarIndex);
 link.textContent = 'BUY ONCE \u2014 NO SAVINGS ' + (price ? formatPrice(price) : '') + ' \u2192';
 }
 function updatePerks() {
 var perks = document.getElementById('nv-sub-perks');
 if (!perks) return;
 var items = perksConfig[selectedBarIndex] || perksConfig[0];
 perks.innerHTML = items.map(function (t) { return '<li>' + t + '</li>'; }).join('');
 }
 function clearAndCheckout(atcBtn, beforeClick) {
 fetch('/cart/clear.js', { method: 'POST', headers: { 'Content-Type': 'application/json' } })
 .then(function () {
 if (beforeClick) beforeClick();
 setTimeout(function () { atcBtn.click(); }, 150);
 var attempts = 0;
 var poll = setInterval(function () {
 attempts++;
 if (attempts > 25) { clearInterval(poll); return; }
 fetch('/cart.js').then(function (r) { return r.json(); }).then(function (cart) {
 if (cart.item_count > 0) { clearInterval(poll); window.location.href = '/checkout'; }
 });
 }, 200);
 });
 }
 function init() {
 if (document.getElementById('nv-buy-once-link')) return;
 var subsWidget = document.querySelector('.kaching-bundles__subscriptions--checkbox');
 var atcBtn = document.querySelector('button.ecom-product-single__add-to-cart--submit') || document.querySelector('button[name="add"]');
 if (!subsWidget || !atcBtn) return;
 var payIcons = document.querySelector('.pay-icons');
 var clearingCart = false;
 atcBtn.addEventListener('click', function (e) {
 if (clearingCart) { clearingCart = false; return; }
 e.preventDefault(); e.stopPropagation();
 clearAndCheckout(atcBtn, function () { clearingCart = true; });
 }, true);
 document.querySelectorAll('.kaching-bundles__bar').forEach(function (bar, i) {
 if (i <= 2) {
 bar.addEventListener('click', function () {
 selectedBarIndex = i;
 updateLinkText();
 updatePerks();
 });
 }
 });
 fetchProductVariants();
 var insertTarget = payIcons || atcBtn.parentElement || atcBtn;
 var perks = document.createElement('ul');
 perks.id = 'nv-sub-perks';
 insertTarget.insertAdjacentElement('afterend', perks);
 updatePerks();
 var link = document.createElement('a');
 link.id = 'nv-buy-once-link';
 link.href = '#';
 link.textContent = 'BUY ONCE \u2014 NO SAVINGS \u2192';
 link.addEventListener('click', function (e) {
 e.preventDefault();
 var checkbox = document.querySelector('.kaching-bundles__bar[role="checkbox"]');
 if (checkbox && checkbox.getAttribute('aria-checked') === 'true') { checkbox.click(); }
 clearAndCheckout(atcBtn, function () { clearingCart = true; });
 });
 perks.insertAdjacentElement('afterend', link);
 updateLinkText();
 }
 /* ---- per-each subtitle: bar price / units, follows subscription toggle ----
 Kaching admin subtitle can say anything; this overwrites it with the live
 computed value. Adjust units here if bar quantities ever change. */
 var UNITS_PER_BAR = [1, 2, 4];
 function updatePerEach() {
 var bars = document.querySelectorAll('.kaching-bundles__bar');
 for (var i = 0; i < UNITS_PER_BAR.length && i < bars.length; i++) {
 if (bars[i].getAttribute('role') === 'checkbox') continue;
 var priceEl = bars[i].querySelector('.kaching-bundles__bar-price');
 var subEl = bars[i].querySelector('.kaching-bundles__bar-subtitle');
 if (!priceEl || !subEl) continue;
 var m = priceEl.textContent.match(/([\u00a3$\u20b1])\s?([\d]+(?:\.\d+)?)/);
 if (!m) continue;
 var txt = m[1] + (parseFloat(m[2].replace(/,/g, '')) / UNITS_PER_BAR[i]).toFixed(2) + '/each';
 if (subEl.textContent !== txt) subEl.textContent = txt;
 }
 }
 setInterval(updatePerEach, 300);
 var attempts = 0;
 var interval = setInterval(function () {
 attempts++;
 if (attempts > 50) { clearInterval(interval); return; }
 if (document.getElementById('nv-buy-once-link')) { clearInterval(interval); return; }
 var subsWidget = document.querySelector('.kaching-bundles__subscriptions--checkbox');
 var atcBtn = document.querySelector('button.ecom-product-single__add-to-cart--submit') || document.querySelector('button[name="add"]');
 if (!subsWidget || !atcBtn) return;
 clearInterval(interval);
 init();
 }, 100);
})();
</script>

 top: -6px;
 right: 0;
 background: rgba(23, 34, 63, 1);
 color: #fff;
 border-radius: 8px;
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 6px;
 white-space: nowrap;
 font-size: 11px;
 font-weight: 700;

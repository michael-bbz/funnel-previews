/* ---- Reset ---- */
.cs-p6-wrap *,
.cs-p6-wrap *::before,
.cs-p6-wrap *::after { box-sizing: border-box; }
.cs-p6-wrap img { display: block; max-width: 100%; height: auto; }
/* ============================================================
 SECTION 1 — CTA Button + Urgency Countdown
 ============================================================ */
.cs-cta {
 background: #fff;
 font-family: Poppins, Arial, sans-serif;
 text-align: center;
 padding: 36px 20px 32px;
}
.cs-cta__btn-wrap {
 display: flex;
 justify-content: center;
 margin-bottom: 10px;
}
.cs-cta__btn {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 background: rgba(7, 59, 99, 1);
 color: #fff;
 font-family: Poppins, Arial, sans-serif;
 font-size: 19px;
 font-weight: 800;
 letter-spacing: 0.01em;
 text-decoration: none;
 padding: 20px 10px;
 border-radius: 8px;
 width: 100%;
 max-width: 409px;
 box-shadow: rgba(0,0,0,0.2) 0 2px 7px 1px;
 transition: background 0.18s;
}
.cs-cta__btn:hover { background: rgba(4, 47, 85, 1); }
/* Urgency timer row */
.cs-urgency-timer {
 display: inline-flex;
 align-items: center;
 justify-content: center;
 gap: 7px;
 font-family: Poppins, Arial, sans-serif;
 font-size: 13.5px;
 color: rgba(204, 34, 0, 1);
 margin-top: 4px;
}
.cs-urgency-clock {
 position: relative;
 width: 16px;
 height: 16px;
 flex: 0 0 16px;
 border: 1.5px solid rgba(204, 34, 0, 1);
 border-radius: 50%;
 background: #fff;
}
.cs-urgency-clock::before {
 content: "";
 position: absolute;
 left: 50%;
 top: 50%;
 width: 3px;
 height: 3px;
 border-radius: 50%;
 background: rgba(204, 34, 0, 1);
 transform: translate(-50%, -50%);
}
.cs-urgency-hand {
 position: absolute;
 left: 50%;
 top: 50%;
 width: 1.5px;
 height: 5.5px;
 border-radius: 999px;
 background: rgba(204, 34, 0, 1);
 transform-origin: 50% 100%;
 animation: cs-hand-spin 3s linear infinite;
}
@keyframes cs-hand-spin {
 from { transform: translate(-50%, -100%) rotate(0deg); }
 to { transform: translate(-50%, -100%) rotate(360deg); }
}
.cs-urgency-copy {
 color: rgba(23, 34, 46, 1);
 letter-spacing: 0.01em;
}
.cs-urgency-sep {
 color: rgba(23, 34, 46, 0.45);
 font-weight: 800;
 margin: 0 -1px;
}
.cs-countdown-time {
 min-width: 48px;
 color: rgba(204, 34, 0, 1);
 font-variant-numeric: tabular-nums;
 font-weight: 800;
 text-align: left;
}
/* ============================================================
 SECTION 2 — Testimonials
 ============================================================ */
.cs-testi {
 background: rgba(250, 244, 238, 1);
 font-family: Poppins, Arial, sans-serif;
 color: rgba(23, 34, 46, 1);
 padding: 48px 20px 36px;
 width: 100vw;
 margin-left: calc(50% - 50vw);
 margin-right: calc(50% - 50vw);
}
.cs-testi__head {
 text-align: center;
 max-width: 760px;
 margin: 0 auto 30px;
}
.cs-testi__head h2 {
 font-size: 30px;
 font-weight: 800;
 color: rgba(23, 34, 46, 1);
 margin: 0;
 line-height: 1.18;
 font-family: Poppins, Arial, sans-serif;
}
.cs-testi__row {
 display: flex;
 flex-direction: row;
 gap: 20px;
 max-width: 1100px;
 margin: 0 auto;
 align-items: stretch;
}
.cs-testi__card {
 flex: 1;
 background: #fff;
 border: 1px solid rgba(232, 228, 223, 1);
 border-radius: 10px;
 box-shadow: 0 10px 22px rgba(23, 34, 46, 0.06);
 overflow: hidden;
 display: flex;
 flex-direction: column;
}
.cs-testi__photo {
 width: 100%;
 display: block;
 object-fit: cover;
 object-position: top center;
}
.cs-testi__body {
 padding: 12px 16px 18px;
 text-align: center;
 flex: 1;
 display: flex;
 flex-direction: column;
}
.cs-testi__stars {
 display: block;
 text-align: center;
 color: rgba(242, 176, 30, 1);
 font-size: 16px;
 line-height: 1;
 letter-spacing: 1px;
 margin: 4px 0 8px;
}
.cs-testi__quote {
 font-size: 14px;
 line-height: 1.65;
 font-style: italic;
 color: rgba(50, 55, 65, 1);
 margin: 0 0 12px;
 flex: 1;
 text-align: center;
}
.cs-testi__author {
 font-size: 14px;
 font-weight: 700;
 color: rgba(23, 34, 46, 1);
 text-align: center;
}
.cs-testi__disclaimer {
 max-width: 980px;
 margin: 24px auto 0;
 text-align: center;
 font-size: 12px;
 font-style: italic;
 color: rgba(100, 100, 100, 1);
 line-height: 1.6;
}
/* ============================================================
 SECTION 3 — Amazon Warning
 ============================================================ */
#cs-amazon-warning {
 background: rgba(250, 236, 236, 1);
 font-family: Poppins, Arial, sans-serif;
 padding: 36px 0;
 width: 100vw;
 margin-left: calc(50% - 50vw);
 margin-right: calc(50% - 50vw);
}
#cs-amazon-warning * {
 font-family: Poppins, Arial, sans-serif !important;
 letter-spacing: 0 !important;
 box-sizing: border-box;
}
.cs-amz-inner {
 display: flex;
 align-items: center;
 justify-content: space-between;
 gap: 64px;
 max-width: 1100px;
 width: 100%;
 margin: 0 auto;
 padding: 0 24px;
}
.cs-amz-copy {
 max-width: 560px;
}
.cs-amz-important {
 display: block;

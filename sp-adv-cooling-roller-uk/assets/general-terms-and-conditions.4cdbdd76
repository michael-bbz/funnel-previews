    document.addEventListener('DOMContentLoaded', function () {
  document.body.addEventListener('click', function(event) {
    var el = event.target;
    // Traverse up in case a span or p inside button is clicked
    while (el && el !== document.body) {
      if (
        el.matches('[name="add"]') ||
        el.hasAttribute('data-replo-add-product-variant-to-cart')
      ) {
        // Try to get product info from the page (may need adjustments for your theme/Replo)
        var productId = window.meta && window.meta.product ? window.meta.product.id : null;
        var price = window.meta && window.meta.product ? window.meta.product.variants[0].price : null;
        var quantity = document.querySelector('input[name="quantity"]') ? document.querySelector('input[name="quantity"]').value : 1;
        if (productId && price) {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'addToCart',
            ecommerce: {
              add: {
                products: [{
                  id: productId,
                  price: price / 100,
                  quantity: quantity
                }]
              }
            }
          });
        }
        break; // Stop traversing if match found
      }
      el = el.parentElement;
    }
  }, true);
});

</script><style> /* =============================== PRODUCT + BLOG CONTENT LINKS =============================== */.product__description a,.product__description a:link,.product__description a:visited,.article-template__content a,.article-template__content a:link,.article-template__content a:visited {color: #052f54 !important;}  /* Hover / active states */.product__description a:hover,.article-template__content a:hover {color: #052f54 !important; text-decoration: underline;}  /* Remove focus outline on mouse click */.product__description a:focus:not(:focus-visible),.article-template__content a:focus:not(:focus-visible) {outline: none !important; box-shadow: none !important;}  /* Keyboard focus only (accessibility-safe) */.product__description a:focus-visible,.article-template__content a:focus-visible {outline: 2px solid #052f54; outline-offset: 2px;}  /* =============================== STOP OUTLINE/BOX ON MOUSE CLICK Keep focus ring for keyboard only =============================== */ /* Remove any theme focus styles on normal focus (mouse click) */a:focus {outline: none !important; box-shadow: none !important;}  /* Bring back focus ring ONLY for keyboard navigation */a:focus-visible {outline: 2px solid currentColor !important; outline-offset: 2px !important; box-shadow: none !important;}  /* Make your scoped areas use the exact color you want */.product__description a:focus-visible,.article-template__content a:focus-visible {outline-color: #052f54 !important;}  /* Footer focus ring stays white */footer a:focus-visible {outline-color: #f8f8fa !important;} </style>
